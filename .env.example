# Docker 部署配置（复制为 .env）
POJUN_TAG=latest
# 镜像名：默认 ghcr.io/chu0119/pojun（amd64/arm64 双架构，CI 随版本发布）
# POJUN_IMAGE=ghcr.io/chu0119/pojun
POSTGRES_USER=pojun
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=pojun

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
POJUN_LLM_PROVIDER=
POJUN_LLM_MODEL=
POJUN_LLM_BASE_URL=
POJUN_LLM_PROXY=
